    "html[data-appearance-transition=\"circle\"]::view-transition-new(root)": {
      "animation": "appearance-circle 700ms cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "html[data-appearance-transition=\"circle-blur\"]::view-transition-new(root)": {

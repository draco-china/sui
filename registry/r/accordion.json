  "css": {
    "@import \"tw-animate-css\"": {},
    "@import \"shadcn/tailwind.css\"": {},
    "@import \"@fontsource-variable/inter\"": {},
    "@property --otp-focus-angle": {
      "syntax": "\"<angle>\"",
      "inherits": "false",
      "initial-value": "0deg"
    },
    "[data-slot=\"input-otp-slot\"]:where([data-focused][tabindex=\"0\"]):not( [data-glass=\"true\"] )": {
      "background": "linear-gradient( color-mix(in oklch, var(--background), var(--input) 55%) 0 0 ) padding-box, conic-gradient( from var(--otp-focus-angle), transparent 0% 18%, var(--ring) 30% 48%, transparent 60% 100% ) border-box",
      "animation": "input-otp-focus 1.8s linear infinite"
    },
    "[data-slot=\"input-otp\"][data-feedback=\"active\"] [data-slot=\"input-otp-slot\"]": {
      "pointer-events": "none",
      "animation": "input-otp-collapse 380ms cubic-bezier(0.65, 0, 0.35, 1) var(--otp-collapse-delay, 0ms) both"
    },
    "[data-slot=\"input-otp-state\"]": {
      "animation": "input-otp-reveal 300ms cubic-bezier(0.34, 1.56, 0.64, 1) 240ms both"
    },
    "[data-slot=\"input-otp-state-icon\"][data-spinning]": {
      "animation": "input-otp-spin 750ms linear infinite"
    },
    "[data-slot=\"input-otp-halo\"]": {
      "position": "absolute",
      "inset": "--spacing(-1)",
      "border-radius": "inherit",
      "box-shadow": "0 0 0 2px color-mix(in oklch, var(--primary) 25%, transparent)",
      "animation": "input-otp-halo 700ms ease-out 100ms both"
    },
    "[data-slot=\"input-otp-particles\"] > span": {
      "position": "absolute",
      "width": "--spacing(1)",
      "height": "--spacing(2)",
      "border-radius": "999px",
      "background": "var(--primary)",
      "animation": "input-otp-particle 850ms cubic-bezier(0.16, 1, 0.3, 1) var(--otp-particle-delay) both"
    },
    "[data-slot=\"input-otp-particles\"] > span:nth-child(3n + 1)": {
      "background": "var(--ring)"
    },
    "[data-slot=\"input-otp-particles\"] > span:nth-child(3n + 2)": {
      "background": "var(--accent-foreground)"
    },
    "[data-slot=\"input-otp-feedback-clock\"]": {
      "position": "absolute",
      "width": "1px",
      "height": "1px",
      "opacity": "0",
      "pointer-events": "none",
      "animation": "input-otp-feedback var(--otp-feedback-duration, 1250ms) linear both"
    },
    "[data-slot=\"input-otp\"][data-feedback=\"restoring\"] [data-slot=\"input-otp-slot\"]": {
      "pointer-events": "none",
      "animation": "input-otp-restore 380ms cubic-bezier(0.16, 1, 0.3, 1) both"
    },
    "[data-slot=\"input-otp\"][data-feedback=\"restoring\"] [data-slot=\"input-otp-state\"]": {
      "animation": "input-otp-dismiss 180ms ease-in both"
    },
    "[data-slot=\"input-otp\"][data-feedback=\"restoring\"] [data-slot=\"input-otp-feedback-clock\"]": {
      "animation-name": "input-otp-restoration",
      "animation-duration": "380ms"
    },
    "[data-slot=\"input-otp\"][data-complete][data-feedback=\"restored\"] [data-slot=\"input-otp-slot\"]": {
      "box-shadow": "0 0 0 2px color-mix(in oklch, var(--ring) 20%, transparent)"
    },
    "@media (prefers-reduced-motion: reduce)": {
      "[data-slot=\"input-otp-state\"], [data-slot=\"input-otp-state-icon\"], [data-slot=\"input-otp-halo\"], [data-slot=\"input-otp-feedback-clock\"]": {
        "animation": "none"
      },
      "[data-slot=\"input-otp-state\"]": {
        "opacity": "1",
        "scale": "1"
      },
      "[data-slot=\"input-otp-slot\"]:where([data-focused][tabindex=\"0\"]):not( [data-glass=\"true\"] ), [data-slot=\"input-otp\"][data-feedback=\"active\"] [data-slot=\"input-otp-slot\"], [data-slot=\"input-otp\"][data-feedback=\"restoring\"] [data-slot=\"input-otp-slot\"], [data-slot=\"input-otp\"][data-feedback=\"restoring\"] [data-slot=\"input-otp-state\"], [data-slot=\"input-otp\"][data-feedback=\"restoring\"] [data-slot=\"input-otp-feedback-clock\"]": {
        "animation": "none"
      },
      "[data-slot=\"input-otp\"][data-feedback=\"active\"] [data-slot=\"input-otp-slot\"]": {
        "opacity": "0"
      },
      "[data-slot=\"input-otp-particles\"]": {
        "display": "none"
      },
      "html[data-appearance-transition]::view-transition-new(root)": {
        "animation": "none"
      }
    },
    "@custom-variant glass (&:is([data-glass=\"true\"], [data-frosted=\"true\"]))": {},
    "@custom-variant glass-off": {
      "@media (prefers-reduced-transparency: reduce), (forced-colors: active)": {
        "@slot": {}
      }
    },
    "@layer components.glass": {
      ":where([data-slot=\"card\"]:is([data-glass=\"true\"], [data-frosted=\"true\"])) > :where([data-slot=\"card-header\"], [data-slot=\"card-footer\"]), :where([data-slot=\"accordion\"]:is([data-glass=\"true\"], [data-frosted=\"true\"])) > :where([data-slot=\"accordion-item\"])": {
        "border-color": "color-mix(in srgb, var(--foreground) 12%, transparent)",
        "@variant glass-off": {
          "border-color": "revert-layer"
        }
      },
      ":where([data-slot=\"accordion\"]):has( > [data-slot=\"accordion-item\"]:is( [data-glass=\"true\"], [data-frosted=\"true\"] ) )": {
        "border-color": "transparent",
        "@variant glass-off": {
          "border-color": "revert-layer"
        }
      },
      ":where( [data-slot=\"accordion\"] > [data-slot=\"accordion-item\"]:is( [data-glass=\"true\"], [data-frosted=\"true\"] ) )": {
        "&:first-child": {
          "border-top-left-radius": "inherit",
          "border-top-right-radius": "inherit",
          "@variant glass-off": {
            "border-top-left-radius": "revert-layer",
            "border-top-right-radius": "revert-layer"
          }
        },
        "&:last-child": {
          "border-bottom-left-radius": "inherit",
          "border-bottom-right-radius": "inherit",
          "@variant glass-off": {
            "border-bottom-left-radius": "revert-layer",
            "border-bottom-right-radius": "revert-layer"
          }
        }
      }
    },
    "[data-glass=\"true\"], [data-slot=\"tabs-list\"][data-glass=\"true\"] [data-slot=\"tabs-trigger\"], [data-slot=\"accordion-item\"][data-glass=\"true\"] > * > [data-slot=\"accordion-trigger\"]": {
      "border-color": "transparent",
      "outline": "none",
      "--tw-ring-color": "transparent",
      "--tw-inset-ring-shadow": "0 0 #0000",
      "--tw-ring-shadow": "0 0 #0000",
      "--tw-ring-offset-shadow": "0 0 #0000",
      "@variant glass-off": {
        "border-color": "revert-layer",
        "outline": "revert-layer",
        "--tw-ring-color": "revert-layer",
        "--tw-inset-ring-shadow": "revert-layer",
        "--tw-ring-shadow": "revert-layer",
        "--tw-ring-offset-shadow": "revert-layer"
      }
    },
    ":is( [data-glass=\"true\"], [data-slot=\"tabs-list\"][data-glass=\"true\"] [data-slot=\"tabs-trigger\"], [data-slot=\"accordion-item\"][data-glass=\"true\"] > * > [data-slot=\"accordion-trigger\"] ):focus-visible, [data-glass=\"true\"]:is( [data-slot=\"input-group\"], [data-slot=\"sensitive-input\"], [data-slot=\"combobox-chips\"], [data-slot=\"tag-input\"], [data-slot=\"wheel-picker\"] ):has(:focus-visible)": {
      "outline": "2px solid var(--ring)",
      "outline-offset": "3px",
      "@media (forced-colors: active)": {
        "outline-color": "Highlight"
      }
    },
    "[data-glass=\"true\"][data-glass-state]": {
      "--glass-edge": "none",
      "--glass-initial-edge-shadow": "initial",
      "--glass-backdrop-blur": "6px",
      "--glass-initial-edge-color": "color-mix( in srgb, color-mix(in srgb, var(--foreground) 12%, white) 28%, transparent )",
      "background-color": "color-mix( in srgb, var(--glass-base, var(--popover)) var(--glass-opacity, 12%), transparent )",
      "background-image": "var(--glass-edge, none)",
      "background-size": "100% 100%",
      "background-repeat": "no-repeat",
      "background-origin": "border-box",
      "background-clip": "border-box",
      "box-shadow": "var( --glass-initial-edge-shadow, inset 0.8px 0.8px 0.4px -0.6px var(--glass-initial-edge-color), inset -0.8px -0.8px 0.4px -0.6px color-mix(in srgb, var(--glass-initial-edge-color) 70%, transparent), 0 1px 3px -1px rgb(0 0 0 / 0.1) ), var(--glass-press, 0 0 #0000), var(--tw-inset-shadow, 0 0 #0000), var(--tw-inset-ring-shadow, 0 0 #0000), var(--tw-ring-offset-shadow, 0 0 #0000), var(--tw-ring-shadow, 0 0 #0000), var(--tw-shadow, 0 0 #0000)",
      "-webkit-backdrop-filter": "blur(var(--glass-backdrop-blur)) saturate(1.3)",
      "backdrop-filter": "blur(var(--glass-backdrop-blur)) saturate(1.3)",
      "&:where([data-slot=\"tab-bar-indicator\"])": {
        "background-color": "transparent",
        "-webkit-backdrop-filter": "none",
        "backdrop-filter": "none"
      },
      "&:where([data-glass-state=\"ready\"][data-glass-renderer=\"svg\"])": {
        "-webkit-backdrop-filter": "var(--glass-filter) saturate(1.3)",
        "backdrop-filter": "var(--glass-filter) saturate(1.3)"
      },
      "@variant glass-off": {
        "--glass-initial-edge-shadow": "0 0 #0000",
        "background-color": "var(--glass-base, var(--popover))",
        "background-image": "none",
        "-webkit-backdrop-filter": "none",
        "backdrop-filter": "none",
        "text-shadow": "none"
      },
      "--glass-halo": "var(--glass-base, var(--popover))",
      "--glass-icon-glow": "drop-shadow( 0 0 1px color-mix(in srgb, var(--glass-halo) 85%, transparent) ) drop-shadow( 0 0 2.5px color-mix(in srgb, var(--glass-halo) 50%, transparent) )",
      "text-shadow": "0 0 0.08em color-mix(in srgb, var(--glass-halo) 90%, transparent), 0 0 0.25em color-mix(in srgb, var(--glass-halo) 60%, transparent)",
      "&[data-glass-text-glow=\"false\"]": {
        "--glass-icon-glow": "none",
        "text-shadow": "none"
      },
      "& :where(svg.lucide)": {
        "filter": "var(--glass-icon-glow)",
        "@variant glass-off": {
          "filter": "revert-layer"
        }
      }
    },
    ":is([data-glass=\"true\"], [data-frosted=\"true\"])": {
      "& :where(.text-muted-foreground)": {
        "color": "color-mix(in oklab, var(--muted-foreground) 40%, var(--foreground))",
        "@variant glass-off": {
          "color": "revert-layer"
        }
      },
      "&::placeholder, & ::placeholder": {
        "color": "color-mix(in oklab, var(--muted-foreground) 65%, var(--foreground))",
        "@variant glass-off": {
          "color": "revert-layer"
        }
      }
    },
    ":is([data-glass=\"true\"], [data-frosted=\"true\"]):is( [data-slot=\"input\"], [data-slot=\"textarea\"], [data-slot=\"input-group\"], [data-slot=\"sensitive-input\"], [data-slot=\"select-trigger\"], [data-slot=\"combobox-chips\"], [data-slot=\"tag-input\"] ):focus-within": {
      "--glass-press": "inset 0 0 0 100vmax rgb(255 255 255 / 0.08)"
    },
    ":is([data-glass=\"true\"], [data-frosted=\"true\"]):is( button, [role=\"button\"], a[href] ):not(:disabled, [aria-disabled=\"true\"])": {
      "transition-property": "color, background-color, box-shadow, scale",
      "transition-duration": "160ms",
      "transition-timing-function": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "&:active": {
        "--glass-press": "inset 0 0 0 100vmax rgb(255 255 255 / 0.1)"
      }

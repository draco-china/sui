{
  "name": "sui",
  "version": "1.1.0",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/draco-china/sui.git"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "biome lint .",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo typecheck",
    "test": "bun test apps/docs/tests",
    "prepare": "lefthook install",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "registry:build": "bun packages/ui/scripts/build-registry.ts",
    "registry:check": "bun packages/ui/scripts/build-registry.ts --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "lefthook": "^2.1.17",
    "semantic-release": "^25.0.9",
    "turbo": "~2.9.14",
    "typescript": "^6.0.2"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": "^22.14.0 || >=24.10.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
